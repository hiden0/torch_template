# --------------------------------------------- #
# DIRs                                          #
# --------------------------------------------- #
HOST_WORKDIR = ""
HOST_DATADIR = ""

# Optional: Change if you want to use a different directory name in the container.
# Default: /app
CONTAINER_WORKDIR = "/app"
CONTAINER_DATADIR = "/data"

# --------------------------------------------- #
# Python                                        #
# --------------------------------------------- #
PYTHON_VERSION = "3.10"

# Optional: Change if you want to use a different directory name in the container.
# Default: /venv
PYTHON_VENV_DIR = "/venv"