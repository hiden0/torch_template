PROJECT_NAME = ""
PROJECT_VERSION = 0.0.0

# --------------------------------------------- #
# User variables                                #
# --------------------------------------------- #

# User variables
# Get USER_NAME using command: whoami
# Get USER_ID using command: id -u
# Get GROUP_ID using command: id -g
# Get VISION_GROUP_ID using command: getent group vision | cut -d: -f3

USER_ID = 
GROUP_ID =  
